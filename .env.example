# reCAPTCHA v3 — copy to `.env` for local dev, and set the same values in Vercel.
#
# PUBLIC site key — safe to expose in the frontend bundle. Exposed to the client
# because it is prefixed VITE_.
VITE_RECAPTCHA_SITE_KEY=

# SECRET key — server-side only. DO NOT put this in .env committed to git and
# DO NOT prefix it with VITE_. Set it in the Vercel dashboard
# (Project → Settings → Environment Variables) as RECAPTCHA_SECRET_KEY.
# Listed here for documentation only:
# RECAPTCHA_SECRET_KEY=

# Optional: override the Formspree endpoint the serverless function forwards to.
# FORMSPREE_ENDPOINT=https://formspree.io/f/xojrgrlr
